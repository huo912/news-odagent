# 复制为 .env 并填入你的密钥
# LLM 提供商（OpenAI / DeepSeek / 其他兼容接口）
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL_NAME=gpt-4o
OPENAI_API_BASE=https://api.openai.com/v1

# 搜索工具（可选，用于搜索工具 agent）
SERPAPI_API_KEY=your_serpapi_key
TAVILY_API_KEY=your_tavily_key

# 推送渠道（可选，用于推送专员）
PUSH_WEBHOOK_URL=
PUSH_CHANNEL=file

# ===== 头条号发布（可选，Playwright 自动化 mp.toutiao.com）=====
# 依赖：pip install -e ".[toutiao]" && playwright install chromium
# 首次使用先登录（扫码或手机号均可）：python -m news_crew.tools.toutiao_tool login
# TOUTIAO_PUBLISH_ENABLED=1
# TOUTIAO_HEADLESS=0
# TOUTIAO_STATE_PATH=

# ===== Nacos（可选，配置后启用远程模型热切换 + 服务注册）=====
# Nacos 服务器地址（必填，留空则两个功能都禁用）
NACOS_SERVER_ADDR=127.0.0.1:8848
# 命名空间 ID（留空为 public）
NACOS_NAMESPACE=
# 配置中心：分组与 dataId（远程模型配置存放位置）
NACOS_GROUP=DEFAULT_GROUP
NACOS_DATA_ID=news-crew-llm.yaml
# 鉴权（可选）
# NACOS_USERNAME=
# NACOS_PASSWORD=
# 服务注册（注册中心）
NACOS_SERVICE_NAME=news-odagent
NACOS_SERVICE_GROUP=DEFAULT_GROUP
# 注册开关：设为 0/false/no/off 跳过服务注册（k8s/kagent 部署中应设 0，
# Pod IP 注册无意义；配置中心热切换不受此开关影响）
# NACOS_REGISTER_ENABLED=0

# ===== kagent A2A 服务（可选，python -m news_crew.server 时使用）=====
# 本地开发需手动设置；k8s BYO Harness 部署时由 Harness 编译器自动注入。
# 注意：kagent-core 在 import 时读取 KAGENT_URL（模块级求值），缺一即报错
# KAGENT_URL=http://localhost:8083
# KAGENT_NAME=news-odagent
# KAGENT_NAMESPACE=default
# 服务监听地址与端口
# HOST=0.0.0.0
# PORT=8080
